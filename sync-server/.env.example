# Optional preconfigured users. New users can also request a token from the client.
COWORKPAL_USERS_JSON={}
COWORKPAL_ADMIN_TOKEN=replace-with-a-different-strong-random-admin-token
# Optional when port 8080 is unavailable on the host.
COWORKPAL_SYNC_PORT=8080
# Maximum number of requests waiting for administrator approval.
MAX_PENDING_REQUESTS=200
