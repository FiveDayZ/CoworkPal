# Listen on the server network so the dashboard is available at
# http://192.168.124.13:18080 inside the LAN.
COWORKPAL_SYNC_BIND=0.0.0.0
COWORKPAL_SYNC_PORT=18080

# Replace this value before deployment. It must be at least 32 characters.
COWORKPAL_ADMIN_TOKEN=replace-with-a-strong-random-admin-token-at-least-32-characters

# New users request their own tokens from the client. Keep this as {} unless
# compatibility with a preconfigured legacy client is required.
COWORKPAL_USERS_JSON={}

MAX_VERSIONS=30
MAX_PENDING_REQUESTS=200
