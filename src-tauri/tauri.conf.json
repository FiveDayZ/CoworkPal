{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoworkPal",
  "version": "1.0.1",
  "identifier": "com.coworkpal.desktop",
  "build": {
    "beforeDevCommand": "npx pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npx pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [
      "binaries/coworkpal-hardware-monitor",
      "binaries/pawnio-setup"
    ],
    "resources": [
      "../hardware-monitor-helper/THIRD_PARTY_NOTICES.md",
      "fonts/NotoSansCJKsc-OFL.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "headerImage": "icons/nsis-header.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
